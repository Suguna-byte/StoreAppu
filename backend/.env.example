# Copy to .env and fill in for local dev. Never commit the real .env file.

DJANGO_SECRET_KEY=change-this-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank locally to use SQLite. Set to a Postgres URL in production, e.g.
# postgres://user:password@host:5432/dbname (Neon/Supabase/Render all give you one)
DATABASE_URL=

# Frontend origin(s) allowed to call this API with cookies
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Set to True only once you're serving both sides over HTTPS in production
SECURE_SSL_REDIRECT=False
COOKIE_SECURE=False

# Razorpay (Dashboard > Settings > API Keys, and Settings > Webhooks for the secret)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Optional: Cloudinary for persistent product image storage in production
# (get this from cloudinary.com dashboard, free tier is plenty for a single store)
CLOUDINARY_URL=

FREE_DELIVERY_RADIUS_KM=8
STORE_LAT=18.5679
STORE_LNG=73.9143
